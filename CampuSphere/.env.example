# ============================================================
# CampuSphere Environment Variables - EXAMPLE
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file to Git.
# ============================================================

# Server
PORT=8080

# Database
DB_URL=jdbc:mysql://localhost:3306/campusphere?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# JWT - CHANGE THIS IN PRODUCTION (must be >= 256 bits / 32+ chars)
JWT_SECRET=replace-this-with-a-strong-random-secret-at-least-32-chars
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Frontend CORS origin
FRONTEND_URL=http://localhost:3000

# AI (leave blank for demo mode)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
